# ===== 应用配置 =====
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRES_IN=7d

# ===== 数据库 =====
DATABASE_URL=postgresql://abs_user:abs_pass@localhost:5432/auto_business
DB_USER=abs_user
DB_PASSWORD=abs_pass
DB_NAME=auto_business

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== AI 模型配置 =====
AI_PROVIDER=mock
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.doubao.com/v1
AI_MODEL_HIGH=doubao-pro-32k
AI_MODEL_MEDIUM=doubao-lite-128k
AI_MODEL_LIGHT=doubao-lite-4k

# ===== 商机平台 =====
V2EX_ENABLED=true
V2EX_CRAWL_INTERVAL=600000
V2EX_API_URL=https://www.v2ex.com/api/topics/show.json
ELEDUCK_ENABLED=true
ELEDUCK_RSS_URL=https://eleduck.com/feed

# ===== 支付配置 =====
PAYMENT_PROVIDER=mock
PAYMENT_CALLBACK_URL=http://localhost:3000/api/v1/finance/payment/callback

# ===== 文件存储 =====
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/deliveries
STORAGE_DOWNLOAD_EXPIRES=604800

# ===== 报价配置 =====
DEFAULT_HOURLY_RATE=150
DEFAULT_PROFIT_MARGIN=0.3
TOKEN_PRICE_INPUT=0.008
TOKEN_PRICE_OUTPUT=0.02

# ===== 预算控制 =====
PROJECT_BUDGET_WARN_RATIO=0.8
PROJECT_BUDGET_STOP_RATIO=1.0
MIN_PROFIT_MARGIN=0.1

# ===== 告警配置 =====
ALERT_EMAIL=admin@example.com
ALERT_SMS_ENABLED=false

# ===== 前端配置 =====
VITE_API_BASE_URL=http://localhost:3000/api/v1
