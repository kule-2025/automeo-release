// 鍏ㄨ嚜鍔ㄧ粡钀ョ鐞嗙郴缁?- 鏁版嵁搴?Schema
// 鍏?6寮犺〃锛岃鐩栧叏涓氬姟鍩?
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== 1. 鐢ㄦ埛琛?==========
model User {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String   @unique
  password_hash String?
  nickname      String?
  avatar        String?
  real_name     String?
  id_card       String?
  status        String   @default("active") // active, disabled, pending_verify
  balance       Decimal  @default(0) @db.Decimal(12, 2) // 鍙彁鐜颁綑棰?
  frozen_amount Decimal  @default(0) @db.Decimal(12, 2) // 鍐荤粨閲戦
  total_income  Decimal  @default(0) @db.Decimal(12, 2)
  total_expense Decimal  @default(0) @db.Decimal(12, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  projects        Project[]
  transactions    FinanceTransaction[]
  withdraws       Withdraw[]
  system_logs     SystemLog[]
  sms_codes       SmsCode[]
}

// ========== 2. 鐭俊楠岃瘉鐮佽〃 ==========
model SmsCode {
  id         String   @id @default(uuid()) @db.Uuid
  phone      String
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [phone], references: [phone])
}

// ========== 3. 鍟嗘満婧愰厤缃〃 ==========
model OpportunitySource {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  platform       String   // v2ex, eleduck, generic
  config_json    Json?
  status         String   @default("active") // active, paused, error
  crawl_interval Int      @default(600000) // 姣
  last_crawl_at  DateTime?
  total_crawled  Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  opportunities Opportunity[]
}

// ========== 4. 鍟嗘満琛?==========
model Opportunity {
  id               String   @id @default(uuid()) @db.Uuid
  source_id        String?  @db.Uuid
  title            String
  description      String?  @db.Text
  source_platform  String
  source_url       String   @unique
  author           String?
  estimated_amount Decimal? @db.Decimal(12, 2)
  match_score      Int?
  profit_score     Int?
  status           String   @default("new") // new, scoring, evaluating, claimed, following, converted, abandoned
  raw_data         Json?
  analysis         String?  @db.Text
  found_at         DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  source    OpportunitySource? @relation(fields: [source_id], references: [id])
  customer  Customer?
}

// ========== 5. 瀹㈡埛琛?==========
model Customer {
  id              String   @id @default(uuid()) @db.Uuid
  opportunity_id  String?  @unique @db.Uuid
  name            String
  contact         String?
  level           String   @default("C") // A, B, C
  status          String   @default("new") // new, contacted, communicating, intent_clear, converted, lost, follow_up
  profile_json    Json?
  deal_probability Int?    @default(0)
  intent_project  String?
  last_contact_at DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  opportunity    Opportunity?      @relation(fields: [opportunity_id], references: [id])
  communications Communication[]
  conversations  AIConversation[]
  requirements   Requirement[]
}

// ========== 6. 娌熼€氳褰曡〃 ==========
model Communication {
  id          String   @id @default(uuid()) @db.Uuid
  customer_id String   @db.Uuid
  direction   String   // outbound, inbound, system
  content     String   @db.Text
  intent_tag  String?  // clear_requirement, negotiation, question, no_interest, general_chat, unknown
  emotion     String?
  created_at  DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
}

// ========== 7. AI浼氳瘽琛?==========
model AIConversation {
  id           String   @id @default(uuid()) @db.Uuid
  customer_id  String   @db.Uuid
  model        String
  task_type    String
  token_usage  Int      @default(0)
  status       String   @default("active")
  started_at   DateTime @default(now())
  ended_at     DateTime?

  customer Customer @relation(fields: [customer_id], references: [id])
}

// ========== 8. 闇€姹傝〃 ==========
model Requirement {
  id              String   @id @default(uuid()) @db.Uuid
  customer_id     String   @db.Uuid
  title           String
  feature_list    Json?
  estimated_hours Decimal? @db.Decimal(10, 2)
  quoted_price    Decimal? @db.Decimal(12, 2)
  cost_estimate   Decimal? @db.Decimal(12, 2)
  status          String   @default("draft") // draft, parsing, quoting, pending_confirm, confirmed, rejected, negotiating
  confirmed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  customer  Customer          @relation(fields: [customer_id], references: [id])
  items     RequirementItem[]
  project   Project?
}

// ========== 9. 闇€姹傚姛鑳介」琛?==========
model RequirementItem {
  id              String   @id @default(uuid()) @db.Uuid
  requirement_id  String   @db.Uuid
  parent_id       String?  @db.Uuid
  name            String
  description     String?  @db.Text
  complexity      String   @default("medium") // low, medium, high
  estimated_hours Decimal  @default(0) @db.Decimal(10, 2)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())

  requirement Requirement     @relation(fields: [requirement_id], references: [id])
  parent      RequirementItem? @relation("ItemHierarchy", fields: [parent_id], references: [id])
  children    RequirementItem[] @relation("ItemHierarchy")
}

// ========== 10. 椤圭洰琛?==========
model Project {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  requirement_id  String?  @unique @db.Uuid
  name            String
  status          String   @default("pending") // pending, in_development, in_review, ready_for_delivery, delivered, accepted, revision, completed, cancelled
  total_hours     Decimal  @default(0) @db.Decimal(10, 2)
  progress        Decimal  @default(0) @db.Decimal(5, 2) // 0-100
  revenue         Decimal  @default(0) @db.Decimal(12, 2)
  cost            Decimal  @default(0) @db.Decimal(12, 2)
  profit          Decimal  @default(0) @db.Decimal(12, 2)
  started_at      DateTime?
  finished_at     DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user         User              @relation(fields: [user_id], references: [id])
  requirement  Requirement?      @relation(fields: [requirement_id], references: [id])
  tasks        ProjectTask[]
  submissions  CodeSubmission[]
  deliveries   Delivery[]
  transactions FinanceTransaction[]
  cost_records CostRecord[]
  token_usages TokenUsage[]
  settlements  Settlement[]
  budget       Budget?
}

// ========== 11. 椤圭洰浠诲姟琛?==========
model ProjectTask {
  id              String   @id @default(uuid()) @db.Uuid
  project_id      String   @db.Uuid
  name            String
  description     String?  @db.Text
  estimated_hours Decimal  @default(0) @db.Decimal(10, 2)
  actual_hours    Decimal  @default(0) @db.Decimal(10, 2)
  status          String   @default("pending") // pending, in_progress, self_testing, ready_for_delivery, completed, failed
  tech_stack      String?
  priority        Int      @default(2) // 1=low, 2=medium, 3=high, 4=critical
  dependencies    Json?
  agent_name      String?
  retry_count     Int      @default(0)
  started_at      DateTime?
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  project      Project          @relation(fields: [project_id], references: [id])
  submissions  CodeSubmission[]
  token_usages TokenUsage[]
}

// ========== 12. 浠ｇ爜鎻愪氦璁板綍琛?==========
model CodeSubmission {
  id               String   @id @default(uuid()) @db.Uuid
  task_id          String   @db.Uuid
  project_id       String   @db.Uuid
  commit_hash      String?
  file_changes     Json?
  quality_score    Int?
  self_test_result Json?
  review_issues    Json?
  submitted_at     DateTime @default(now())

  task    ProjectTask @relation(fields: [task_id], references: [id])
  project Project     @relation(fields: [project_id], references: [id])
}

// ========== 13. 浜や粯琛?==========
model Delivery {
  id           String   @id @default(uuid()) @db.Uuid
  project_id   String   @db.Uuid
  version      String   @default("v1.0.0")
  status       String   @default("pending") // pending, packaging, delivered, viewed, in_acceptance, accepted, needs_revision
  delivered_at DateTime?
  accepted_at  DateTime?
  download_url String?
  file_hash    String?
  revision_count Int   @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  project Project       @relation(fields: [project_id], references: [id])
  files   DeliveryFile[]
}

// ========== 14. 浜や粯鏂囦欢琛?==========
model DeliveryFile {
  id           String   @id @default(uuid()) @db.Uuid
  delivery_id  String   @db.Uuid
  file_name    String
  file_path    String
  file_size    Int
  file_type    String
  created_at   DateTime @default(now())

  delivery Delivery @relation(fields: [delivery_id], references: [id])
}

// ========== 15. 璐㈠姟浜ゆ槗琛?==========
model FinanceTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String   @db.Uuid
  project_id     String?  @db.Uuid
  type           String   // project_income, token_cost, compute_cost, third_party_cost, withdraw, refund
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("pending") // pending, paid, settled, failed, cancelled
  channel        String?
  transaction_no String?  @unique
  remark         String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user    User     @relation(fields: [user_id], references: [id])
  project Project? @relation(fields: [project_id], references: [id])
}

// ========== 16. 鎻愮幇琛?==========
model Withdraw {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  status        String   @default("processing") // processing, completed, failed, cancelled
  bank_account  String?
  bank_name     String?
  account_name  String?
  transaction_no String?
  failure_reason String?
  created_at    DateTime @default(now())
  completed_at  DateTime?

  user User @relation(fields: [user_id], references: [id])
}

// ========== 17. 鎴愭湰鍒嗙被琛?==========
model CostCategory {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  type   String // token, compute, third_party, other
  unit   String?
  price  Decimal? @db.Decimal(10, 4)

  cost_records CostRecord[]
}

// ========== 18. 鎴愭湰璁板綍琛?==========
model CostRecord {
  id          String   @id @default(uuid()) @db.Uuid
  project_id  String?  @db.Uuid
  category_id String?  @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  detail_json Json?
  created_at  DateTime @default(now())

  project  Project?      @relation(fields: [project_id], references: [id])
  category CostCategory? @relation(fields: [category_id], references: [id])
}

// ========== 19. Token娑堣€楄〃 ==========
model TokenUsage {
  id               String   @id @default(uuid()) @db.Uuid
  project_id       String?  @db.Uuid
  task_id          String?  @db.Uuid
  model            String
  task_type        String?
  prompt_tokens    Int      @default(0)
  completion_tokens Int     @default(0)
  cost             Decimal  @default(0) @db.Decimal(10, 4)
  created_at       DateTime @default(now())

  project Project?     @relation(fields: [project_id], references: [id])
  task    ProjectTask? @relation(fields: [task_id], references: [id])
}

// ========== 20. 绠楀姏璧勬簮琛?==========
model ComputeResource {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  type          String // cpu, gpu, cloud_instance
  spec          String?
  status        String   @default("running") // running, stopped, error, maintenance
  monthly_cost  Decimal  @default(0) @db.Decimal(10, 2)
  load_percent  Int      @default(0)
  max_concurrent Int     @default(3)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ========== 21. 鍛婅浜嬩欢琛?==========
model AlertEvent {
  id           String   @id @default(uuid()) @db.Uuid
  module       String   // opportunity, customer, requirement, project, delivery, finance, cost, ai_gateway, system
  level        String   // critical, warning, info
  message      String   @db.Text
  status       String   @default("pending") // pending, processing, resolved, escalated
  detail_json  Json?
  triggered_at DateTime @default(now())
  resolved_at  DateTime?
  resolved_by  String?
  resolution   String?  @db.Text
}

// ========== 22. 绯荤粺鎿嶄綔鏃ュ織琛?==========
model SystemLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?  @db.Uuid
  action      String
  target_type String?
  target_id   String?
  detail_json Json?
  ip          String?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])
}

// ========== 23. 鎶ヤ环瑙勫垯琛?==========
model QuoteRule {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  hourly_rate             Decimal  @default(150) @db.Decimal(10, 2)
  complexity_coefficients Json?    // {low: 0.8, medium: 1.0, high: 1.5}
  profit_margin           Decimal  @default(0.3) @db.Decimal(5, 4)
  urgency_coefficient     Decimal  @default(1.0) @db.Decimal(5, 4)
  token_input_price       Decimal  @default(0.008) @db.Decimal(10, 4)
  token_output_price      Decimal  @default(0.02) @db.Decimal(10, 4)
  is_default              Boolean  @default(false)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

// ========== 24. 鍏滃簳瑙勫垯琛?==========
model FallbackRule {
  id              String   @id @default(uuid()) @db.Uuid
  module          String
  exception_type  String
  max_retries     Int      @default(3)
  action          String   // retry, degrade, pause, manual
  condition_json  Json?
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ========== 25. 缁撶畻璁板綍琛?==========
model Settlement {
  id            String   @id @default(uuid()) @db.Uuid
  project_id    String   @db.Uuid
  revenue       Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  profit        Decimal  @db.Decimal(12, 2)
  profit_margin Decimal  @db.Decimal(5, 4)
  status        String   @default("pending") // pending, completed
  settled_at    DateTime?
  created_at    DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id])
}

// ========== 26. 棰勭畻閰嶇疆琛?==========
model Budget {
  id            String   @id @default(uuid()) @db.Uuid
  project_id    String   @unique @db.Uuid
  total_budget  Decimal  @db.Decimal(12, 2)
  used_amount   Decimal  @default(0) @db.Decimal(12, 2)
  warn_ratio    Decimal  @default(0.8) @db.Decimal(5, 4)
  stop_ratio    Decimal  @default(1.0) @db.Decimal(5, 4)
  is_frozen     Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  project Project @relation(fields: [project_id], references: [id])
}

// ========== 27. Agent瑙掕壊瀹氫箟琛?==========
model AgentRole {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  capabilities_json Json?    // 鑳藉姏鏍囩鏁扮粍
  skills_json Json?    // 鎶€鑳藉垪琛?
  default_model String   @default("doubao-pro-32k")
  created_at    DateTime @default(now())

  employees DigitalEmployee[]
}

// ========== 28. 鏁板瓧鍖栧憳宸ヨ〃 ==========
model DigitalEmployee {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  role_id              String   @db.Uuid
  status               String   @default("active") // active, working, resting, retired
  profile_json Json?    // 鑳藉姏鐢诲儚
  assigned_project_count Int    @default(0)
  success_rate         Decimal  @default(0) @db.Decimal(5, 4)
  total_tasks          Int      @default(0)
  avg_quality_score    Decimal  @default(0) @db.Decimal(5, 2)
  hired_at             DateTime @default(now())
  retired_at           DateTime?
  created_at           DateTime @default(now())

  role         AgentRole       @relation(fields: [role_id], references: [id])
  performances AgentPerformance[]
}

// ========== 29. Agent缁╂晥琛?==========
model AgentPerformance {
  id            String   @id @default(uuid()) @db.Uuid
  employee_id   String   @db.Uuid
  project_id    String?  @db.Uuid
  task_id       String?
  task_type     String
  quality_score Decimal  @db.Decimal(5, 2)
  duration_ms   Int
  success       Boolean  @default(true)
  feedback_json Json?
  created_at    DateTime @default(now())

  employee DigitalEmployee @relation(fields: [employee_id], references: [id])
}

// ========== 30. 鎻愮ず璇嶇増鏈〃 ==========
model PromptVersion {
  id              String   @id @default(uuid()) @db.Uuid
  task_type       String
  version         String
  content         String
  variables       Json?
  is_active       Boolean  @default(false)
  is_ab_test      Boolean  @default(false)
  ab_test_group   String?  // A, B
  parent_version_id String? @db.Uuid
  created_by      String?
  created_at      DateTime @default(now())

  ab_test_results ABTestResult[]
}

// ========== 31. 缁忛獙搴撹〃 ==========
model Experience {
  id              String   @id @default(uuid()) @db.Uuid
  category        String   // success_case, failure_lesson, best_practice
  title           String
  content         String
  tags            Json?
  source          String?  // opportunity_conversion, customer_communication, project_delivery, quote_strategy
  related_project_id String? @db.Uuid
  metrics         Json?    // 鍏抽敭鎸囨爣
  created_at      DateTime @default(now())
}

// ========== 32. 杩涘寲鎸囨爣琛?==========
model EvolutionMetric {
  id               String   @id @default(uuid()) @db.Uuid
  metric_name      String   @unique
  current_value    Decimal  @db.Decimal(10, 4)
  target_value     Decimal  @db.Decimal(10, 4)
  historical_values Json?   // 30澶╁巻鍙叉暟鎹?  trend            String   @default("stable") // up, down, stable
  last_updated_at  DateTime @updatedAt
}

// ========== 33. A/B娴嬭瘯缁撴灉琛?==========
model ABTestResult {
  id               String   @id @default(uuid()) @db.Uuid
  prompt_version_id String  @db.Uuid
  task_type        String
  total_calls      Int      @default(0)
  success_count    Int      @default(0)
  avg_quality_score Decimal @default(0) @db.Decimal(5, 2)
  avg_duration_ms  Int      @default(0)
  winner_group     String?
  started_at       DateTime @default(now())
  ended_at         DateTime?

  prompt_version PromptVersion @relation(fields: [prompt_version_id], references: [id])
}

// ========== 34. 瀵硅瘽浼氳瘽琛?==========
model ChatSession {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  status     String   @default("active") // active, archived
  context    Json?    // 涓婁笅鏂囨憳瑕?  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  messages ChatMessage[]
}

// ========== 35. 瀵硅瘽娑堟伅琛?==========
model ChatMessage {
  id         String   @id @default(uuid()) @db.Uuid
  session_id String   @db.Uuid
  role       String   // user, assistant, system, tool
  content    String
  intent     String?
  action     Json?
  tool_calls Json?
  created_at DateTime @default(now())

  session ChatSession @relation(fields: [session_id], references: [id])
}

// ========== 36. 宸ヤ綔娴佸姩浣滃畾涔夎〃 ==========
model WorkflowAction {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  description     String
  intent_keywords Json?    // 瑙﹀彂鍏抽敭璇?  parameters      Json?    // 鍙傛暟瀹氫箟
  endpoint        String
  method          String   @default("GET")
  created_at      DateTime @default(now())
}

// ========== 37. 宸ュ叿瀹氫箟琛?==========
model ToolDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  display_name    String
  description     String
  category        String   // database, file, code, search, math, http, system, time
  parameters      Json?    // JSON Schema
  return_type     String?
  is_enabled      Boolean  @default(true)
  call_count      Int      @default(0)
  success_count   Int      @default(0)
  avg_duration_ms Int      @default(0)
  created_at      DateTime @default(now())
}

// ========== 38. 宸ュ叿璋冪敤鏃ュ織琛?==========
model ToolCallLog {
  id            String   @id @default(uuid()) @db.Uuid
  tool_name     String
  parameters    Json?
  result        Json?
  success       Boolean  @default(true)
  error_message String?
  duration_ms   Int
  caller_type   String?  // agent, chat, system
  caller_id     String?
  project_id    String?  @db.Uuid
  created_at    DateTime @default(now())
}
