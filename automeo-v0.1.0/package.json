{
  "name": "auto-business-system",
  "version": "1.0.0",
  "private": true,
  "description": "全自动经营管理系统 - 从商机发现到财务结算的全链路自动化平台",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @abs/api",
    "dev:web": "npm run dev --workspace @abs/web",
    "build:api": "npm run build --workspace @abs/api",
    "build:web": "npm run build --workspace @abs/web",
    "build:shared": "npm run build --workspace @abs/shared",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" --fix",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\"",
    "prisma:generate": "npm run prisma:generate --workspace @abs/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @abs/api",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
